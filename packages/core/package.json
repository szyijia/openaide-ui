{
  "name": "@openaide/core",
  "version": "0.1.0",
  "private": true,
  "description": "OpenAIDE Agent 核心引擎",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "bundle": "esbuild src/bridge-server.ts --bundle --outfile=dist/bridge-server.bundle.cjs --format=cjs --platform=node --target=node20 --minify --external:fsevents",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@openaide/protocol": "workspace:*",
    "openai": "^4.76.0",
    "zod": "^3.24.0",
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "esbuild": "^0.24.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.0.0"
  }
}